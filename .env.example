# Chave da API do Google Gemini (opcional). Sem ela, a calculadora funciona normalmente
# e a análise usa as regras internas; apenas o chat fica indisponível.
# Gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo do Gemini (opcional, padrão: gemini-2.5-flash)
GEMINI_MODEL=

# URL pública do site, usada em canonical, sitemap e Open Graph
NEXT_PUBLIC_SITE_URL=https://devlator.com
